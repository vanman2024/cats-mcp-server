# CATS MCP Server configuration
#
# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# See docs/DEPLOYMENT.md for the full reference.
#
# On Prefect Horizon these are set in the UI (Settings -> Environment Variables),
# not from this file, and changing one requires a rebuild to take effect.

# --- Required ---------------------------------------------------------------
CATS_API_KEY=your_cats_api_key_here

# --- Discovery --------------------------------------------------------------
# search  search_tools + call_tool + pinned tools. For direct clients.
# raw     the full catalog. For orchestrators doing their own tool discovery.
# code    Code Mode sandbox. Needs the code-mode extra. Experimental.
CATS_DISCOVERY_MODE=search

# Limit which resources load, e.g. candidates,jobs,pipelines. Omit for all.
# CATS_TOOLSETS=

# --- Transport --------------------------------------------------------------
# stdio for local clients (Claude Desktop, Cursor). http for remote.
CATS_TRANSPORT=stdio
# CATS_HOST=0.0.0.0
# CATS_PORT=8000

# --- Authentication of the MCP caller ---------------------------------------
# Required when CATS_TRANSPORT=http. No default: assuming a gateway that is not
# there exposes destructive tools, and assuming none breaks a fronted deployment.
#
# platform  a gateway in front authenticates first (Horizon, reverse proxy)
# jwt       this server verifies bearer tokens itself
# none      nobody does - local development only
# CATS_AUTH_MODE=platform

# Required by CATS_AUTH_MODE=jwt
# CATS_AUTH_JWKS_URI=https://your-issuer/.well-known/jwks.json
# CATS_AUTH_ISSUER=https://your-issuer/
# CATS_AUTH_AUDIENCE=cats-mcp

# --- Tuning -----------------------------------------------------------------
# CATS_SEARCH_MAX_RESULTS=5
# CATS_REQUEST_TIMEOUT=30.0
# CATS_MAX_RETRIES=4
# LOG_LEVEL=INFO
