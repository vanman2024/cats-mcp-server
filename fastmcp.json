{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "src/cats_mcp/app.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.10",
    "dependencies": [
      "fastmcp==4.0.0b2",
      "httpx2==2.10.0",
      "pydantic==2.13.4",
      "python-dotenv==1.2.2"
    ]
  },
  "deployment": {
    "transport": "http",
    "host": "0.0.0.0",
    "port": 3000,
    "path": "/mcp/",
    "log_level": "INFO",
    "env": {
      "CATS_API_BASE_URL": "https://api.catsone.com/v3",
      "CATS_API_KEY": "${CATS_API_KEY}",
      "CATS_TRANSPORT": "http",
      "CATS_HOST": "0.0.0.0",
      "CATS_PORT": "3000"
    }
  }
}
